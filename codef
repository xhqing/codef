#!/bin/bash
# version: 0.6.0（与仓库根 VERSION 保持一致，安装到生产目录后可凭此行核对版本）
# codef —— 全屏（或左半屏全屏）打开 VSCode，并确保刚打开的那个窗口位于最上层。
# 用法：codef [路径]        （默认当前目录；等于 code . + 自动全屏 + 目标窗口置顶）
#       codef left [路径]   （把 VSCode 摆到屏幕左半并进入全屏——等价于窗口菜单的
#                            「全屏 → 屏幕左侧」；脚本只做这一步，右侧完全交给你
#                            自己安排；平铺不可用时回退为普通窗口左半屏摆放。
#                            若运行它的终端窗口处于原生全屏，会先退出终端全屏再执行；
#                            若同目录已有左半平铺窗口，会另开新窗口接管、不再复用）
#                            平铺前会自动清理残留的「配对会话」面板（详见流程 1.5）
#                            `left` 是关键字——要打开名为 left 的目录请写 `codef ./left`
#       codef --version    （查看当前版本：输出 `codef x.y.z`，版本号与仓库根 VERSION 一致）
#
# 背景：`code <dir>` 打开后 macOS 只保证 VSCode 应用被激活，不保证哪个窗口
# 在最上层——多窗口时置顶的可能不是本次要打开的那个，且窗口创建有延迟，
# 固定 sleep 再按键的时序不可靠。
#
# 实现：
#   2. 记录打开前 VSCode 的窗口标题列表
#   3. code <dir> 打开（新开窗口或复用已有窗口由 VSCode 决定）
#   4. 轮询等目标窗口出现（标题以目录名开头；优先锁定「本次新增」的窗口）
#   5. 点击菜单栏「Window / 窗口」菜单里的目标窗口项把它带到最前
#      （系统级聚焦语义，目标窗口在其他 Space 或已全屏时也能切换过去）；
#      菜单找不到时退回 AXRaise
#   6. 目标窗口未全屏时才模拟 Ctrl+Cmd+F（避免把已全屏的窗口退出全屏）
#
# left 模式的完整流程：
#   0. 若承载本命令的终端窗口处于原生全屏（AXFullScreen），先退出其全屏
#      （终端 App 按 TERM_PROGRAM 识别；tmux 下沿已附加客户端的进程链找外层终端；
#      识别不出时该步静默跳过、不阻塞流程）；
#   1. 取主屏可视区（NSScreen.visibleFrame），供「平铺就绪检测」与「失败回退摆放」用；
#   1.5 配对面板预检（2026-10-18 增，issue #24）：探测 Dock 的 half-backdrop 面板
#      （「全屏幕平铺 → 屏幕左侧」配对会话的残留物，跨 Space 可见）；命中则发送 Esc
#      取消残留会话、短暂等待后再探测确认；结果 absent / cleared / clear-failed 记入
#      失败诊断日志（pairing-panel 行）与失败提示（探测与清理均 best-effort、不阻塞）；
#   然后走 2~5（目标窗口置顶）；第 6 步改为：
#     若目标窗口已是「左半全屏」→ 另开新窗口接管（issue #28）：在别名根下建
#     符号链接别名（CODEF_ALIAS_ROOT 可覆盖，默认 ~/Library/Caches/codef/aliases）→
#     code <别名> 开出第二窗口 → 旧窗退出全屏（尽力，失败不阻断）→ 新窗平铺；
#     别名创建失败时告警并保持旧行为（复用已有窗口、静默成功）；
#     否则（独立全屏态先退出全屏）触发 Window → Full Screen Tile → Left of Screen
#     （子菜单懒加载，需先展开），轮询至窗口进入左半全屏态后结束；
#     单次触发被系统静默忽略时自动重试（最多 3 次尝试；2026-10-14 增——实测
#     macOS 26 上偶发「菜单项可点、动作无效果、无任何报错」的忽略形态）；
#     触发失败或全部尝试未就绪时回退为普通窗口左半屏摆放（保底），并把诊断
#     时间线追加到 ~/Library/Logs/codef.log（2026-10-14 增）。
#
# 前提：运行它的终端 App 需在「系统设置 → 隐私与安全性 → 辅助功能」中授权，
# 否则窗口枚举 / 模拟按键会被系统拒绝（not allowed assistive access）。
# 调试：CODEF_DEBUG=1 codef 会输出各阶段状态。
# 诊断日志：left 模式失败时自动落盘 ~/Library/Logs/codef.log。

set -u

# --version：打印当前版本（版本号取自脚本头部 version 行，与仓库根 VERSION 一致）
if [ "${1:-}" = "--version" ]; then
  v=$(sed -n '2p' "${BASH_SOURCE[0]}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  echo "codef ${v}"
  exit 0
fi

# 参数：codef [路径] | codef left [路径]
# `left` 作为首参是模式关键字（目录名恰好叫 left 时用 `codef ./left`）。
mode="full"
if [ "${1:-}" = "left" ]; then
  mode="left"
  shift
fi
dir="${1:-.}"
abs_dir=$(cd -- "$dir" 2>/dev/null && pwd -P) || { echo "codef: 目录不存在：$dir" >&2; exit 1; }
command -v code >/dev/null 2>&1 || { echo "codef: 找不到 code 命令" >&2; exit 1; }
target_name=$(basename "$abs_dir")
debug() { [ "${CODEF_DEBUG:-}" = "1" ] && echo "codef: $*" >&2 || true; }

# —— 终端 App 识别（left 模式预处理用）——

# 沿进程链向上找 GUI App（.app 包）的 bundle identifier；找不到时输出空、返回非零。
app_bundle_of_pid() {
  local p="$1" cmd app
  while [ -n "$p" ] && [ "$p" != "1" ] && [ "$p" != "0" ]; do
    cmd=$(ps -o comm= -p "$p" 2>/dev/null) || break
    case "$cmd" in
      *.app/Contents/MacOS/*)
        app="${cmd%%/Contents/MacOS/*}"
        if [ -r "${app}/Contents/Info.plist" ]; then
          defaults read "${app}/Contents/Info" CFBundleIdentifier 2>/dev/null && return 0
        fi
        ;;
    esac
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  return 1
}

# 承载本命令的终端 App 的 bundle identifier；识别不出时返回非零。
# 判定：TERM_PROGRAM 映射为主（覆盖常见终端）；tmux 会把 TERM_PROGRAM 覆盖为
# "tmux"，此时沿已附加客户端的进程链找外层终端 App。
detect_term_bundle() {
  local pid="" found="" pids="" bid=""
  case "${TERM_PROGRAM:-}" in
    ghostty)        echo "com.mitchellh.ghostty" ;;
    iTerm.app)      echo "com.googlecode.iterm2" ;;
    Apple_Terminal) echo "com.apple.Terminal" ;;
    WezTerm)        echo "com.github.wez.wezterm" ;;
    WarpTerminal)   echo "dev.warp.Warp-Stable" ;;
    vscode)         echo "com.microsoft.VSCode" ;;
    Hyper)          echo "co.zeit.hyper" ;;
    kitty)          echo "net.kovidgoyal.kitty" ;;
    Alacritty)      echo "org.alacritty" ;;
    Tabby)          echo "org.tabby" ;;
    tmux)
      # tmux 覆盖 TERM_PROGRAM=tmux：沿已附加客户端的进程链识别外层终端 App
      command -v tmux >/dev/null 2>&1 || return 1
      pids=$(tmux list-clients -F '#{client_pid}' 2>/dev/null || true)
      for pid in $pids; do
        bid=$(app_bundle_of_pid "$pid" 2>/dev/null || true)
        [ -z "$bid" ] && continue
        if [ -z "$found" ]; then
          found="$bid"
        elif [ "$found" != "$bid" ]; then
          return 1 # 多个客户端指向不同 App：无法判定，放弃
        fi
      done
      if [ -n "$found" ]; then
        echo "$found"
        return 0
      fi
      return 1
      ;;
    *) return 1 ;;
  esac
  return 0
}

# —— left 模式：配对面板（half-backdrop）预检 ——
# 「全屏幕平铺 → 屏幕左侧」成功后系统会启动一个「选右半屏伙伴」的配对会话（Dock
# 绘制的 half-backdrop 面板）；会话未完成又未取消而残留时，后续所有左半平铺请求
# 会被系统静默忽略（菜单 enabled、点击无效果、窗口无变化）——2026-10-18 实机定位
# （issue #24）。触发前先探测并用 Esc 取消残留会话，避免这种「间歇失灵」。
# 探测走 CGWindowList（跨 Space 可见）；任何失败都按「未检出」容错、不阻塞主流程。
pairing_panel_probe() {
  osascript -l JavaScript -e '
ObjC.import("CoreGraphics");
var found = "no";
var raw = $.CGWindowListCopyWindowInfo(0, 0);
var n = $.CFArrayGetCount(raw);
for (var i = 0; i < n; i++) {
  var w = ObjC.deepUnwrap(ObjC.castRefToObject($.CFArrayGetValueAtIndex(raw, i)));
  if (w.kCGWindowOwnerName === "Dock" && w.kCGWindowName === "half-backdrop") { found = "yes"; break; }
}
found;
' 2>/dev/null | tr -d '[:space:]' || true
}

# 预检并（必要时）取消残留配对会话；stdout 输出处理结果（供失败提示与诊断日志）：
#   absent       —— 未检出面板（含探测失败），未做任何动作
#   cleared      —— 检出并已取消（Esc 后再探测已消失）
#   clear-failed —— 检出但 Esc 后仍在（可能在其他 Space，需人工处理）
clear_stale_pairing_panel() {
  local p
  p=$(pairing_panel_probe)
  if [ "$p" != "yes" ]; then
    printf 'absent'
    return 0
  fi
  debug "配对面板预检：检出残留面板（Dock half-backdrop），发送 Esc 取消残留配对会话"
  osascript -e 'tell application "System Events" to key code 53' >/dev/null 2>&1 || true
  sleep 0.6
  p=$(pairing_panel_probe)
  if [ "$p" = "yes" ]; then
    printf 'clear-failed'
  else
    printf 'cleared'
  fi
}

# 0) left 模式：若承载本命令的终端窗口处于原生全屏，先退出其全屏
#    （终端识别不出 / 退出失败时静默跳过——best effort，主流程照常继续）
if [ "$mode" = "left" ]; then
  term_bid=$(detect_term_bundle 2>/dev/null || true)
  if [ -n "$term_bid" ]; then
    term_fs_out=$(osascript - "$term_bid" <<'OSA' 2>/dev/null || true
-- 承载本命令的终端 App 的聚焦窗口若处于原生全屏，退出其全屏。
-- best effort：任何失败都不阻塞主流程。返回 not-fullscreen / exited /
-- exit-failed / no-app / no-window 之一。
on run argv
	set bid to item 1 of argv
	tell application "System Events"
		set p to missing value
		try
			set p to first application process whose bundle identifier is bid
		end try
		if p is missing value then return "no-app"
		tell p
			-- 聚焦窗口（兜底主窗口）
			set w to missing value
			try
				set w to value of attribute "AXFocusedWindow"
			end try
			if w is missing value then
				try
					set w to value of attribute "AXMainWindow"
				end try
			end if
			if w is missing value then return "no-window"

			set isFS to false
			try
				set isFS to value of attribute "AXFullScreen" of w
			end try
			if not isFS then return "not-fullscreen"

			-- 先尝试直接设置属性退出全屏（不抢焦点），未生效再回退按键
			try
				set value of attribute "AXFullScreen" of w to false
			end try
			repeat 15 times
				delay 0.2
				set fsNow to true
				try
					set fsNow to value of attribute "AXFullScreen" of w
				end try
				if not fsNow then
					delay 0.4
					return "exited"
				end if
			end repeat

			-- 回退：激活该 App、聚焦窗口后模拟 Ctrl+Cmd+F
			try
				set frontmost of p to true
			end try
			try
				perform action "AXRaise" of w
			end try
			delay 0.4
			keystroke "f" using {command down, control down}
			repeat 15 times
				delay 0.2
				set fsNow to true
				try
					set fsNow to value of attribute "AXFullScreen" of w
				end try
				if not fsNow then
					delay 0.4
					return "exited"
				end if
			end repeat
			return "exit-failed"
		end tell
	end tell
end run
OSA
)
    debug "终端全屏预处理（${term_bid}）：${term_fs_out:-无输出}"
  else
    debug "终端全屏预处理：未识别承载命令的终端 App，跳过"
  fi
fi

# 1) left 模式：取主屏可视区（左半屏位置 / 尺寸，用于平铺就绪检测与失败回退摆放）
lx=0; ly=0; lw=0; lh=0
pairing_note="absent"
if [ "$mode" = "left" ]; then
  frame=$(osascript -l JavaScript -e 'ObjC.import("AppKit"); var f=$.NSScreen.mainScreen.visibleFrame; var g=$.NSScreen.mainScreen.frame; Math.round(f.origin.x)+","+Math.round(g.size.height-f.origin.y-f.size.height)+","+Math.round(f.size.width)+","+Math.round(f.size.height)' 2>/dev/null || true)
  if [ -n "$frame" ]; then
    IFS=, read -r sx sy sw sh <<<"$frame"
    half_w=$(( sw / 2 ))
    lx=$sx; ly=$sy; lw=$half_w; lh=$sh
    debug "屏幕可视区: ${frame}；左半: ${lx},${ly},${lw},${lh}"
  else
    echo "codef: 无法获取屏幕可视区（left 模式的就绪检测与失败回退将跳过）" >&2
  fi
  # 配对面板预检：清理残留配对会话（否则后续左半平铺会被系统静默忽略；须在 code 之前）
  pairing_note=$(clear_stale_pairing_panel)
  debug "配对面板预检结果：${pairing_note}"
fi

# 2) 记录打开前的窗口标题（VSCode 未运行时为空）
pre_names=$(osascript <<'OSA' 2>/dev/null || true
tell application "System Events"
	if not (exists process "Code") then return ""
	tell process "Code"
		set out to ""
		repeat with n in (get name of every window)
			set out to out & (n as text) & linefeed
		end repeat
		return out
	end tell
end tell
OSA
)
debug "目标目录: $abs_dir (匹配名: $target_name)"
debug "打开前窗口: [$(echo "$pre_names" | tr '\n' '|')]"

# 3) 打开 VSCode
code "$abs_dir"

# 4~6) 等目标窗口出现 → 置顶 → 默认模式全屏 / left 模式左半全屏序列
# （封装为函数供两遍复用：left-new 新窗接管时以第 8 参传旧窗口名再调一次）
main_ascript() {
  osascript - "$@" <<'OSA'

-- 去掉段首的脏标记（● / • / *）与首尾空白
on cleanSegment(t)
	set out to t as text
	repeat while (count of out) > 0 and ((character 1 of out) is in {"●", "•", "*"})
		if (count of out) > 1 then
			set out to text 2 thru -1 of out
		else
			set out to ""
		end if
	end repeat
	repeat while (count of out) > 0 and ((character 1 of out) is space)
		if (count of out) > 1 then
			set out to text 2 thru -1 of out
		else
			set out to ""
		end if
	end repeat
	repeat while (count of out) > 0 and ((character -1 of out) is space)
		if (count of out) > 1 then
			set out to text 1 thru ((count of out) - 1) of out
		else
			set out to ""
		end if
	end repeat
	return out
end cleanSegment

-- 窗口标题是否属于目标目录：
-- VSCode 默认 window.title 带活动文件时是「文件名 — 目录名」（文件在前，
-- 实测用户环境即此形态），复用窗口即为此；纯目录名、脏标记（●）、
-- em dash / en dash / 连字符分隔等形态都要覆盖。
-- 实现：按分隔符拆段，逐段去标记去空白后与目录名「精确相等」比较——
-- 段间精确比较天然避免目录名互为子串的误匹配（2026-10-12 事故修复）。
on matchesTarget(n, targetName)
	set t to my cleanSegment(n as text)
	if t is targetName then return true
	repeat with sep in {" — ", " – ", " - "}
		set AppleScript's text item delimiters to (sep as text)
		set segs to every text item of t
		set AppleScript's text item delimiters to ""
		repeat with s in segs
			if my cleanSegment(s as text) is targetName then return true
		end repeat
	end repeat
	return false
end matchesTarget

-- 通过点击菜单栏「Window / 窗口」菜单里的窗口项聚焦目标窗口
-- （系统级聚焦语义，目标窗口在其他 Space 或已全屏时也能切换过去）
on raiseViaMenu(targetName)
	tell application "System Events"
		tell process "Code"
			repeat with menuName in {"Window", "窗口"}
				try
					set targetItem to (first menu item of menu 1 of menu bar item (menuName as text) of menu bar 1 whose name starts with targetName)
					click targetItem
					return true
				end try
			end repeat
		end tell
	end tell
	return false
end raiseViaMenu

-- 采集目标窗口当前状态（全屏标志 / 位置 / 尺寸），供诊断日志用
on winState(targetWin)
	set out to "fs=? p=? s=?"
	try
		tell application "System Events" to tell process "Code"
			set fsVal to "?"
			try
				set fsVal to (value of attribute "AXFullScreen" of window targetWin) as text
			end try
			set p to position of window targetWin
			set s to size of window targetWin
			set out to "fs=" & fsVal & " p=" & (item 1 of p as text) & "," & (item 2 of p as text) & " s=" & (item 1 of s as text) & "," & (item 2 of s as text)
		end tell
	end try
	return out
end winState

-- 采集聚焦 / 主窗口与前台状态（判断菜单动作可能落到哪个窗口），供诊断日志用
on focusState()
	set out to "focus=?"
	try
		tell application "System Events" to tell process "Code"
			set fw to ""
			set mw to ""
			try
				set fw to name of value of attribute "AXFocusedWindow"
			end try
			try
				set mw to name of value of attribute "AXMainWindow"
			end try
			set out to "frontmost=" & (frontmost as text) & " focused=" & fw & " main=" & mw
		end tell
	end try
	return out
end focusState

-- 诊断行列表拼成多行文本
on joinLines(lst)
	set out to ""
	repeat with ln in lst
		set out to out & (ln as text) & linefeed
	end repeat
	if (count of out) > 0 then
		if character -1 of out is linefeed then set out to text 1 thru -2 of out
	end if
	return out
end joinLines

on run argv
	set targetName to item 1 of argv
	set preText to item 2 of argv
	set modeArg to item 3 of argv
	set lx to (item 4 of argv) as integer
	set ly to (item 5 of argv) as integer
	set lw to (item 6 of argv) as integer
	set lh to (item 7 of argv) as integer
	set oldWin to ""
	try
		set oldWin to item 8 of argv
	end try

	-- activate 带重试：code 命令的打开请求刚发出时 VSCode 主线程忙于处理，
	-- 紧随的 Apple Event 会被断连（-609 Connection is invalid），重试至成功
	repeat 6 times
		try
			tell application id "com.microsoft.VSCode" to activate
			exit repeat
		end try
		delay 0.25
	end repeat

	tell application "System Events"
		-- 冷启动场景：等 VSCode 进程出现
		repeat 40 times
			if exists process "Code" then exit repeat
			delay 0.25
		end repeat
		if not (exists process "Code") then return "no-process"

		tell process "Code"
			set frontmost to true

			-- 轮询等目标窗口出现（新窗口创建有延迟，冷启动更慢）
			set targetWin to missing value
			repeat 40 times
				set winNames to (get name of every window)

				-- 优先锁定「本次打开后新增」的匹配窗口
				repeat with n in winNames
					set t to n as text
					if my matchesTarget(t, targetName) then
						set isNew to true
						repeat with p in (paragraphs of preText)
							if (p as text) is t then
								set isNew to false
								exit repeat
							end if
						end repeat
						if isNew then
							set targetWin to t
							exit repeat
						end if
					end if
				end repeat

				-- 兜底：第一个标题匹配的窗口（VSCode 复用已有窗口的场景）
				if targetWin is missing value then
					repeat with n in winNames
						if my matchesTarget(n as text, targetName) then
							set targetWin to (n as text)
							exit repeat
						end if
					end repeat
				end if

				if targetWin is not missing value then exit repeat
				delay 0.25
			end repeat
			if targetWin is missing value then return "no-window"
		end tell

		-- 置顶：先走菜单（菜单项生成有延迟，重试几轮），失败退回 AXRaise
		set raised to false
		repeat 3 times
			if raised then exit repeat
			set raised to my raiseViaMenu(targetName)
			if not raised then delay 0.3
		end repeat
		if not raised then
			try
				perform action "AXRaise" of window targetWin of process "Code"
				set raised to true
			end try
		end if
		if not raised then return "no-raise"

		delay 0.4 -- 等窗口聚焦 / Space 切换动画

		set isFS to false
		try
			set isFS to value of attribute "AXFullScreen" of window targetWin of process "Code"
		end try

		if modeArg is "left" or modeArg is "left-new" then
			-- 把目标窗口摆到左全屏（等价于菜单「全屏 → 屏幕左侧」）；
			-- 右侧窗口的选择完全交给用户/系统（脚本不代点，2026-10-13 用户决定）

			-- 幂等：目标窗口已是「左半全屏」→ 视为已就绪，直接成功返回
			-- （lw 为 0 表示屏幕可视区未知，此时仅按全屏态判断）
			set fs0 to false
			set x0 to -1
			set w0 to 0
			try
				set fs0 to value of attribute "AXFullScreen" of window targetWin of process "Code"
				set p0 to position of window targetWin of process "Code"
				set s0 to size of window targetWin of process "Code"
				set x0 to item 1 of p0
				set w0 to item 1 of s0
			end try
			if fs0 and (lw is 0 or (x0 ≤ lx + 2 and w0 ≥ lw - 30 and w0 ≤ lw + 30)) then return "splitview-already" & linefeed & targetWin

			-- 其他全屏态（独立全屏）：先退出全屏，从普通窗口开始平铺
			if fs0 then
				keystroke "f" using {command down, control down}
				delay 1.8
			end if

			-- 触发 Window → Full Screen Tile → Left of Screen。
			-- macOS 26 实测：偶发「菜单项 enabled、点击无报错、但系统静默忽略动作」
			-- （2026-10-14 排查）；故单次触发不足——未就绪时重开菜单再触发，最多
			-- 3 次尝试；每次尝试采集窗口 / 菜单状态进诊断列表（失败时由调用方落盘）。
			set diagLines to {"screen: lx=" & (lx as text) & " ly=" & (ly as text) & " lw=" & (lw as text) & " lh=" & (lh as text)}

			-- left-new：先让旧窗退出全屏（接管）；失败不阻断，仅记诊断
			if modeArg is "left-new" and oldWin is not "" then
				-- 同目录新旧两窗同名，菜单提窗可能点到旧窗——显式把新窗抬到最前
				try
					perform action "AXRaise" of window targetWin of process "Code"
				end try
				delay 0.3
				set oldExitNote to "old-exit: skip"
				try
					set value of attribute "AXFullScreen" of window oldWin of process "Code" to false
					set oldExitNote to "old-exit: requested"
					repeat 20 times
						delay 0.2
						set oldFs to false
						try
							set oldFs to value of attribute "AXFullScreen" of window oldWin of process "Code"
						end try
						if not oldFs then
							set oldExitNote to "old-exit: exited"
							exit repeat
						end if
					end repeat
				on error e
					set oldExitNote to "old-exit: error " & (e as text)
				end try
				set end of diagLines to oldExitNote
				delay 0.4
			end if

			set maxAttempts to 3
			set pollCount to 20
			set everTriggered to false
			set triggerErrAll to ""

			repeat with attempt from 1 to maxAttempts
				set attemptTag to "attempt " & (attempt as text)
				set end of diagLines to attemptTag & " before: " & my winState(targetWin) & " / " & my focusState()

				-- 单次触发（菜单名 Window / 窗口 兼容；子菜单懒加载需先 pick 展开）
				set triggered to false
				set triggerErr to ""
				repeat with menuName in {"Window", "窗口"}
					if triggered then exit repeat
					try
						set wm to menu bar item (menuName as text) of menu bar 1 of process "Code"
						pick menu item "Full Screen Tile" of menu 1 of wm
						delay 0.5
						set itemEnabled to "?"
						try
							set itemEnabled to (enabled of menu item "Left of Screen" of menu 1 of menu item "Full Screen Tile" of menu 1 of wm) as text
						end try
						click menu item "Left of Screen" of menu 1 of menu item "Full Screen Tile" of menu 1 of wm
						set triggered to true
						set everTriggered to true
						set end of diagLines to attemptTag & " trigger(" & (menuName as text) & "): clicked, left-of-screen enabled=" & itemEnabled
					on error e number n
						set triggerErr to triggerErr & "[" & (menuName as text) & ":" & n & ":" & (e as text) & "]"
					end try
				end repeat

				if not triggered then
					set triggerErrAll to triggerErrAll & triggerErr
					set end of diagLines to attemptTag & " trigger-error: " & triggerErr
					if not everTriggered then
						-- 菜单一直不可用（如旧系统无此菜单）：按触发失败返回，不空转重试
						return "tile-failed: " & triggerErrAll & linefeed & targetWin & linefeed & my joinLines(diagLines)
					end if
					exit repeat
				end if

				-- 就绪轮询（窗口进入左半全屏态为就绪；约 3 秒）
				repeat pollCount times
					delay 0.15
					set fsR to false
					set xR to -1
					set wR to 0
					try
						set fsR to value of attribute "AXFullScreen" of window targetWin of process "Code"
						set pR to position of window targetWin of process "Code"
						set sR to size of window targetWin of process "Code"
						set xR to item 1 of pR
						set wR to item 1 of sR
					end try
					if fsR and (lw is 0 or (xR ≤ lx + 2 and wR ≥ lw - 30 and wR ≤ lw + 30)) then
						return "tile-ready" & linefeed & targetWin & linefeed & my joinLines(diagLines)
					end if
				end repeat
				set end of diagLines to attemptTag & " after: " & my winState(targetWin)

				-- 未就绪：若窗口进了独立全屏（触发有效果但形态不对），先退出全屏再重试
				set fsNow to false
				try
					set fsNow to value of attribute "AXFullScreen" of window targetWin of process "Code"
				end try
				if fsNow then
					keystroke "f" using {command down, control down}
					delay 1.5
					set end of diagLines to attemptTag & " exited fullscreen"
				else
					delay 0.6
				end if
			end repeat

			-- 全部尝试失败：退全屏复位后报未就绪（由调用方回退半屏摆放）
			set end of diagLines to "result: not-ready after attempts"
			try
				if value of attribute "AXFullScreen" of window targetWin of process "Code" then
					keystroke "f" using {command down, control down}
					delay 1.5
				end if
			end try
			return "tile-not-ready" & linefeed & targetWin & linefeed & my joinLines(diagLines)
		end if

		-- 默认模式：未全屏才发全屏键（对已全屏窗口重复 Ctrl+Cmd+F 会退出全屏）
		if not isFS then
			keystroke "f" using {command down, control down}
		end if
		return "ok:" & isFS & linefeed & targetWin
	end tell
end run
OSA
}

result=$(main_ascript "$target_name" "$pre_names" "$mode" "$lx" "$ly" "$lw" "$lh")
status=$(printf '%s' "$result" | head -1)
win_name=$(printf '%s' "$result" | tail -n +2 | head -1)
diag=$(printf '%s' "$result" | tail -n +3)
debug "结果: ${status}${win_name:+ [窗口: ${win_name}]}"

# left 模式：命中「同目录已有左半平铺窗口」→ 另开新窗口接管（issue #28）
# 流程：建符号链接别名（绕过 code 的目录去重）→ code <别名> 开第二窗口 →
# 以 left-new 模式再调主 AppleScript（旧窗退全屏 + 新窗平铺，复用既有重试）。
new_window_used=""
if [ "$status" = "splitview-already" ] && [ "$mode" = "left" ]; then
  alias_root="${CODEF_ALIAS_ROOT:-$HOME/Library/Caches/codef/aliases}"
  alias_dir="${alias_root}/$(date +%s)-$$"
  alias_path="${alias_dir}/${target_name}"
  if mkdir -p "$alias_dir" 2>/dev/null && ln -s "$abs_dir" "$alias_path" 2>/dev/null; then
    debug "新窗流程：别名 ${alias_path} -> ${abs_dir}（旧窗：${win_name:-未知}）"
    pre_names2=$(osascript <<'OSA' 2>/dev/null || true
tell application "System Events"
	if not (exists process "Code") then return ""
	tell process "Code"
		set out to ""
		repeat with n in (get name of every window)
			set out to out & (n as text) & linefeed
		end repeat
		return out
	end tell
end tell
OSA
)
    code "$alias_path"
    # 配对面板预检（新窗流程第二遍之前同样要清理残留会话）
    pairing_note=$(clear_stale_pairing_panel)
    debug "配对面板预检结果（新窗流程）：${pairing_note}"
    result=$(main_ascript "$target_name" "$pre_names2" "left-new" "$lx" "$ly" "$lw" "$lh" "${win_name:-}")
    status=$(printf '%s' "$result" | head -1)
    win_name=$(printf '%s' "$result" | tail -n +2 | head -1)
    diag=$(printf 'new-window: alias=%s\n%s' "$alias_path" "$(printf '%s' "$result" | tail -n +3)")
    new_window_used=1
    debug "新窗流程结果: ${status}${win_name:+ [窗口: ${win_name}]}"
  else
    echo "codef: 无法创建别名（${alias_path}），保持复用已有窗口" >&2
  fi
fi

# left 模式平铺失败时收尾：清理全屏态（尽力）+ 回退为普通窗口左半屏摆放（保底）
fallback_note="（未执行）"
logfile="$HOME/Library/Logs/codef.log"

# 失败时把诊断时间线追加到日志文件（2026-10-14 增：平铺被系统静默忽略的事故没有
# 可回溯日志；left 模式的 AppleScript 已采集每次尝试的窗口 / 菜单状态）。
log_failure() {
  local v
  v=$(sed -n '2p' "${BASH_SOURCE[0]}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  {
    printf '===== %s  codef %s  mode=%s  target=%s =====\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${v:-?}" "$mode" "$target_name"
    printf 'dir: %s\n' "$abs_dir"
    if [ "$mode" = "left" ]; then printf 'pairing-panel: %s\n' "${pairing_note:-absent}"; fi
    if [ -n "${diag:-}" ]; then printf '%s\n' "$diag"; fi
    printf 'fallback: %s\n' "$fallback_note"
    printf 'status: %s\n\n' "$1"
  } >> "$logfile" 2>/dev/null || debug "诊断日志写入失败：${logfile}"
}

left_fallback() {
  local out
  out=$(osascript - "$lx" "$ly" "$lw" "$lh" "${win_name:-}" <<'OSA' 2>/dev/null || echo "fallback-error"
-- 平铺失败收尾：把目标窗口从全屏态退出并摆回左半屏（普通窗口保底）。
on run argv
	set lx to (item 1 of argv) as integer
	set ly to (item 2 of argv) as integer
	set lw to (item 3 of argv) as integer
	set lh to (item 4 of argv) as integer
	set winName to item 5 of argv
	tell application "System Events"
		tell process "Code"
			set frontmost to true
			delay 0.3
			set targetWin to missing value
			try
				if winName is not "" then set targetWin to window winName
			end try
			if targetWin is missing value then
				repeat with w in windows
					set s to size of w
					if (item 1 of s) > 2 then
						set targetWin to w
						exit repeat
					end if
				end repeat
			end if
			if targetWin is missing value then return "no-window"
			set isFS to false
			try
				set isFS to value of attribute "AXFullScreen" of targetWin
			end try
			if isFS then
				keystroke "f" using {command down, control down}
				delay 1.8
			end if
			set position of targetWin to {lx, ly}
			set size of targetWin to {lw, lh}
			return "fallback-done"
		end tell
	end tell
end run
OSA
)
  case "$out" in
    fallback-done) fallback_note="已回退半屏摆放（${target_name}）"; debug "已回退半屏摆放（${target_name}）" ;;
    no-window)     fallback_note="回退时找不到目标窗口"; debug "回退时找不到目标窗口" ;;
    *)             fallback_note="回退处理异常: ${out}"; debug "回退处理异常: ${out}" ;;
  esac
}

# 失败提示：按配对面板预检结果补充说明（absent 不加提示）
pairing_hint=""
case "$pairing_note" in
  cleared)      pairing_hint="（提示：检测到并已自动清除残留的配对面板）" ;;
  clear-failed) pairing_hint="（提示：检测到残留的配对面板且未能自动清除——请按 Esc 或点击桌面空白处后重试）" ;;
esac

case "$status" in
  splitview-already)
    debug "目标窗口已在左半屏全屏，无需操作"
    ;;
  ok:*)
    : # 默认模式全屏流程完成
    ;;
  tile-ready)
    if [ -n "$new_window_used" ]; then
      echo "codef: 同目录已有左半平铺窗口，已另开新窗口并接管左半屏全屏。"
    else
      echo "codef: VSCode 已进入左半屏全屏。"
    fi
    ;;
  tile-failed*)
    if [ "$lw" -gt 0 ]; then
      left_fallback
      echo "codef: 左半平铺触发失败（Window → Full Screen Tile 菜单不可用），已回退为普通窗口左半屏摆放${pairing_hint}；诊断日志：${logfile}" >&2
    else
      echo "codef: 左半平铺触发失败（Window → Full Screen Tile 菜单不可用），且无法获取屏幕可视区，未回退摆放${pairing_hint}；诊断日志：${logfile}" >&2
    fi
    log_failure "$status"
    ;;
  tile-not-ready)
    if [ "$lw" -gt 0 ]; then
      left_fallback
      echo "codef: 左半平铺未就绪（窗口未进入左半全屏态），已回退为普通窗口左半屏摆放${pairing_hint}；诊断日志：${logfile}" >&2
    else
      echo "codef: 左半平铺未就绪（窗口未进入左半全屏态），且无法获取屏幕可视区，未回退摆放${pairing_hint}；诊断日志：${logfile}" >&2
    fi
    log_failure "$status"
    ;;
  no-process) echo "codef: 等待 VSCode 进程启动超时（10 秒），本次未置顶/全屏；诊断日志：${logfile}" >&2; log_failure "$status" ;;
  no-window)  echo "codef: 未找到标题匹配「${target_name}」的窗口（VSCode 窗口标题格式可能变了）；诊断日志：${logfile}" >&2; log_failure "$status" ;;
  no-raise)   echo "codef: 找到目标窗口但置顶失败（菜单与 AXRaise 均未成功）；诊断日志：${logfile}" >&2; log_failure "$status" ;;
  *)          echo "codef: 未预期的结果：${result}" >&2; log_failure "$status" ;;
esac
exit 0
